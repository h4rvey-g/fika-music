{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fika Music",
  "mainBinaryName": "fika-music",
  "version": "0.1.1",
  "identifier": "com.hvg.fika-music",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Fika Music",
        "width": 1440,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 650
      },
      {
        "label": "desktop-lyrics",
        "url": "index.html?window=desktop-lyrics",
        "title": "Fika Music Desktop Lyrics",
        "width": 720,
        "height": 150,
        "minWidth": 320,
        "minHeight": 100,
        "center": true,
        "visible": false,
        "focus": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": ["plugins"],
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
