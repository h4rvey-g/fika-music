{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fika-music",
  "mainBinaryName": "fika-music",
  "version": "0.1.0",
  "identifier": "com.hvg.fika-music",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "fika-music",
        "width": 1200,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": ["plugins"],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
